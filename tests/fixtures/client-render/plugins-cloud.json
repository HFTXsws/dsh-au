        },
        {
         "t": "div",
         "p": {
          "className": "dsh-au-insp-id",
          "key": "meta"
         },
         "c": "v1.0.0 · dsh-acp-adapter"
        },
        {
         "t": "div",
         "p": {
          "className": "dsh-au-chips",
          "key": "status"
         },
         "c": [
          {
           "t": "span",
           "p": {
            "className": "dsh-au-chip",
            "data-tone": "muted",
            "key": "未安装-0"
           },
           "c": "未安装"
          },
          {
           "t": "span",
           "p": {
            "className": "dsh-au-chip",
            "data-tone": "blue",
            "key": "云插件-1"
           },
           "c": "云插件"
          }
         ]
        },
        {
         "t": "div",
         "p": {
          "className": "dsh-au-act-block",
          "key": "action"
         },
         "c": [
          {
           "t": "button",
           "p": {
            "className": "dsh-au-btn on",
            "disabled": false,
            "onClick": "[fn]",
            "type": "button"
           },
           "c": "接入本机"
          },
          {
           "t": "div",
           "p": {
            "className": "dsh-au-act-hint"
           },
           "c": "安装并启用 · 重启 DSH 后生效"
          }
         ]
        },
        {
         "t": "div",
         "p": {
          "className": "dsh-au-act-block",
          "key": "remove"
         },
         "c": [
          {
           "t": "button",
           "p": {
            "className": "dsh-au-link",
            "data-tone": "danger",
            "disabled": false,
            "onClick": "[fn]",
            "type": "button"
           },
           "c": "从云清单移除"
          },
          {
           "t": "div",
           "p": {
            "className": "dsh-au-act-hint"
           },
           "c": "所有电脑都看不到 · 不影响本机"
          }
         ]
        },
        {
         "t": "div",
         "p": {
          "className": "dsh-au-note",
          "key": "note"
         },
         "c": "同步完成"
        }
       ]
      }
     }
    ]
   },
   {
    "t": "footer",
    "p": {
     "className": "dsh-au-wb-foot"
    },
    "c": [
     {
      "t": "span",
      "p": {},
      "c": "支持序号直达 · 双击无参卡片直接执行 · 后台服务独立于 DSH 运行，支持按电脑保存自启组合"
     },
     {
      "t": "span",
      "p": {},
      "c": "本机: TestBook · 菜单清单: menu.json"
     }
    ]
   }
  ]
 }
}
