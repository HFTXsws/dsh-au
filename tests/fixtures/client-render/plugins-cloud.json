{
 "t": "div",
 "p": {
  "className": "dsh-au-mask",
  "onClick": "[fn]"
 },
 "c": {
  "t": "div",
  "p": {
   "aria-modal": "true",
   "className": "dsh-au-wb-modal",
   "role": "dialog"
  },
  "c": [
   {
    "t": "header",
    "p": {
     "className": "dsh-au-wb-head"
    },
    "c": [
     {
      "t": "input",
      "p": {
       "autoFocus": false,
       "className": "dsh-au-wb-search",
       "onChange": "[fn]",
       "placeholder": "输入菜单序号、服务名或关键字检索...",
       "value": ""
      },
      "c": null
     },
     {
      "t": "div",
      "p": {
       "style": {
        "display": "flex",
        "alignItems": "center",
        "gap": "8px"
       }
      },
      "c": [
       {
        "t": "button",
        "p": {
         "className": "dsh-au-wb-pill on",
         "onClick": "[fn]",
         "title": "自动识别当前系统；点击可切换预览 Windows / macOS 专属菜单项",
         "type": "button"
        },
        "c": "系统识别: macOS (.sh)"
       },
       {
        "t": "button",
        "p": {
         "className": "dsh-au-btn",
         "disabled": false,
         "onClick": "[fn]",
         "title": "立即重新检查后台服务运行状态（默认 1 小时自动缓存）",
         "type": "button"
        },
        "c": "刷新"
       },
       {
        "t": "button",
        "p": {
         "className": "dsh-au-btn",
         "onClick": "[fn]",
         "type": "button"
        },
        "c": "关闭 (Esc)"
       }
      ]
     }
    ]
   },
   {
    "t": "div",
    "p": {
