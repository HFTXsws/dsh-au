     },
     {
      "t": "section",
      "p": {
       "className": "dsh-au-wb-center"
      },
      "c": {
       "t": "#fragment",
       "p": {},
       "c": [
        {
         "t": "div",
         "p": {
          "key": "tabs",
          "style": {
           "display": "flex",
           "gap": "7px",
           "paddingBottom": "3px",
           "borderBottom": "1px solid #1f2637",
           "alignItems": "center",
           "justifyContent": "space-between",
           "flexWrap": "wrap"
          }
         },
         "c": [
          {
           "t": "div",
           "p": {
            "key": "view-pills",
            "style": {
             "display": "flex",
             "gap": "7px"
            }
           },
           "c": [
            {
             "t": "button",
             "p": {
              "className": "dsh-au-wb-pill ",
              "key": "local",
              "onClick": "[fn]",
              "type": "button"
             },
             "c": "本机插件 2"
            },
            {
             "t": "button",
             "p": {
              "className": "dsh-au-wb-pill sel",
              "key": "cloud",
              "onClick": "[fn]",
              "type": "button"
             },
             "c": "云插件 2"
            }
           ]
          },
          {
           "t": "div",
           "p": {
            "key": "batch-actions",
            "style": {
             "display": "flex",
             "gap": "6px",
             "flexWrap": "wrap"
            }
           },
           "c": [
            {
             "t": "button",
             "p": {
              "className": "dsh-au-wb-pill",
              "disabled": false,
              "key": "plugin-doctor",
              "onClick": "[fn]",
              "title": "只检查运行时、实际版本与快照，不安装插件、不修改本机配置",
              "type": "button"
             },
             "c": "只读体检"
            },
            {
             "t": "button",
             "p": {
              "className": "dsh-au-wb-pill on",
              "disabled": false,
              "key": "restore-preview",
              "onClick": "[fn]",
              "title": "对比云端插件清单与本机 DSH Profile 的差异，确认后从云端一键还原到本地",
              "type": "button"
             },
             "c": "一键还原到本地"
            }
           ]
          }
         ]
        },
        {
         "t": "section",
         "p": {
          "className": "dsh-au-quota-shell",
          "key": "notice"
         },
         "c": [
          {
           "t": "strong",
           "p": {
            "key": "title"
           },
           "c": "云插件 · 当前电脑已接入 1/2 项"
          },
          {
           "t": "span",
           "p": {
            "key": "text",
            "style": {
             "color": "#94a3b8",
             "fontSize": "15px"
            }
           },
           "c": "选中插件后在详情面板操作；也可点击右上角「一键还原到本地」从云端一键恢复全部云插件与配置。"
          }
         ]
        },
        {
         "t": "div",
         "p": {
          "className": "dsh-au-wb-grid",
          "key": "grid"
         },
         "c": [
          {
           "t": "div",
           "p": {
            "className": "dsh-au-wb-card ",
            "key": "dsh-au",
            "onClick": "[fn]"
           },
           "c": [
            {
             "t": "div",
             "p": {
              "className": "dsh-au-card-head",
              "key": "head"
             },
             "c": [
              {
               "t": "div",
               "p": {
                "className": "dsh-au-card-title-row",
                "key": "title-row"
               },
               "c": [
                {
                 "t": "span",
                 "p": {
                  "className": "dsh-au-card-title",
                  "key": "title"
                 },
                 "c": "DSH AU"
                },
                {
                 "t": "span",
                 "p": {
                  "className": "dsh-au-chip dsh-au-chip-own",
                  "data-tone": "violet",
                  "key": "own",
                  "title": "DSH-Au 团队自研插件，非社区插件"
                 },
                 "c": "自研"
                }
               ]
              }
             ]
            },
            {
             "t": "div",
             "p": {
              "className": "dsh-au-card-ver",
              "key": "meta"
             },
             "c": "v0.1.0 · dsh-au"
            },
            {
             "t": "div",
             "p": {
              "className": "dsh-au-card-desc",
              "key": "desc"
             },
             "c": "多机远程与局域网自发现工作区插件"
            },
            {
             "t": "div",
             "p": {
              "className": "dsh-au-card-status",
              "key": "status"
             },
             "c": [
              {
               "t": "span",
               "p": {
                "className": "dsh-au-chip",
                "data-tone": "emerald",
                "key": "启用中-0"
               },
               "c": "启用中"
              },
              {
               "t": "span",
               "p": {
                "className": "dsh-au-chip",
                "data-tone": "blue",
                "key": "已接入云同步-1"
               },
               "c": "已接入云同步"
              }
             ]
            }
           ]
          },
          {
           "t": "div",
           "p": {
            "className": "dsh-au-wb-card selected",
            "key": "dsh-acp-adapter",
            "onClick": "[fn]"
           },
           "c": [
            {
             "t": "div",
             "p": {
              "className": "dsh-au-card-head",
              "key": "head"
             },
             "c": [
              {
               "t": "div",
               "p": {
                "className": "dsh-au-card-title-row",
                "key": "title-row"
               },
               "c": [
                {
                 "t": "span",
                 "p": {
                  "className": "dsh-au-card-title",
                  "key": "title"
                 },
                 "c": "Cursor ACP"
                }
               ]
              }
             ]
            },
            {
             "t": "div",
             "p": {
              "className": "dsh-au-card-ver",
              "key": "meta"
             },
             "c": "v1.0.0 · dsh-acp-adapter"
            },
            {
             "t": "div",
             "p": {
              "className": "dsh-au-card-status",
              "key": "status"
             },
             "c": [
              {
               "t": "span",
               "p": {
                "className": "dsh-au-chip",
                "data-tone": "muted",
                "key": "未安装-0"
               },
               "c": "未安装"
              },
              {
               "t": "span",
               "p": {
                "className": "dsh-au-chip",
                "data-tone": "blue",
                "key": "云插件-1"
               },
               "c": "云插件"
              }
             ]
            }
           ]
          }
         ]
        }
       ]
      }
     },
     {
      "t": "aside",
      "p": {
       "className": "dsh-au-wb-inspector"
      },
      "c": {
       "t": "#fragment",
       "p": {},
