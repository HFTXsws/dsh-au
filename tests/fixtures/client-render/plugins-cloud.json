           },
           {
            "t": "span",
            "p": {
             "className": "dsh-au-nav-label",
             "key": "label"
            },
            "c": "全部菜单指令"
           }
          ]
         },
         {
          "t": "span",
          "p": {
           "className": "dsh-au-nav-count"
          },
          "c": "6"
         }
        ]
       },
       {
        "t": "button",
        "p": {
         "className": "dsh-au-wb-navbtn ",
         "key": "basic",
         "onClick": "[fn]",
         "type": "button"
        },
        "c": [
         {
          "t": "span",
          "p": {
           "className": "dsh-au-nav-main"
          },
          "c": [
           {
            "t": "span",
            "p": {
             "className": "dsh-au-nav-icon",
             "key": "icon"
            },
            "c": {
             "t": "span",
             "p": {
              "className": "dsh-au-nav-dot"
